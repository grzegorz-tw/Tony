# Usage: cmake -DSRC=<build>/bin -DDST=<stage dir> -DEXES="a.exe;b.exe" -P CopyEngine.cmake
# Upstream projects write to <build>/bin (single-config) or <build>/bin/<Config> (Visual Studio).
file(MAKE_DIRECTORY "${DST}")
set(_dir "")
foreach(cand "${SRC}/Release" "${SRC}/RelWithDebInfo" "${SRC}")
  if(EXISTS "${cand}/")
    foreach(exe ${EXES})
      if(EXISTS "${cand}/${exe}")
        set(_dir "${cand}")
      endif()
    endforeach()
  endif()
  if(_dir)
    break()
  endif()
endforeach()
if(NOT _dir)
  message(FATAL_ERROR "none of ${EXES} found under ${SRC}")
endif()
file(GLOB _files "${_dir}/*.exe" "${_dir}/*.dll")
foreach(f ${_files})
  get_filename_component(n "${f}" NAME)
  if(n MATCHES "^(llama-server|whisper-server|sd|ggml.*|llama.*|mtmd|whisper|stable-diffusion|libomp.*|vulkan.*)\\.(exe|dll)$")
    file(COPY "${f}" DESTINATION "${DST}")
  endif()
endforeach()
